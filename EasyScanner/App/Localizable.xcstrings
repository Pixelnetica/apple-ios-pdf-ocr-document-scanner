    "settings-simulate-multipage-desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single page will be written into the output document. Applicable for PDF and TIFF files only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird eine einzelne Seite in das Ausgabedokument geschrieben. Nur für PDF- und TIFF-Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escribirá una sola página en el documento de salida. Solo aplicable a archivos PDF y TIFF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule page sera écrite dans le document de sortie. Applicable uniquement aux fichiers PDF et TIFF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà scritta una singola pagina nel documento di output. Valido solo per i file PDF e TIFF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出文档中将只写入单页。仅适用于 PDF 和 TIFF 文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力書類には 1 ページのみ書き込まれます。PDF および TIFF ファイルにのみ適用されます。"
          }
        }
      }
    },
