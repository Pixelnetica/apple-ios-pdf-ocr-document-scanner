    "settings-smart-crop-desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images will be processed automatically. Manual correction will be offered only in case of low quality document border detection"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder werden automatisch verarbeitet. Eine manuelle Korrektur wird nur bei geringer Qualität der Dokumentkantenerkennung angeboten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes se procesarán automáticamente. Solo se ofrecerá una corrección manual en caso de una detección de bordes de baja calidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images seront traitées automatiquement. Une correction manuelle ne sera proposée qu'en cas de détection des bords de mauvaise qualité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini verranno elaborate automaticamente. La correzione manuale verrà proposta solo in caso di rilevamento dei bordi di bassa qualità."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像将自动处理。仅在文档边框检测质量较低时才提供手动校正。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は自動的に処理されます。手動での補正は、書類の境界検出の品質が低い場合にのみ表示されます。"
          }
        }
      }
    },
